# Deployer private key (NEVER commit real keys!)
# Required for `npm run deploy:*`. There is no fallback - deploys fail without it.
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ARC Testnet RPC
ARC_RPC_URL=https://testnet.arc.io/rpc
ARC_CHAIN_ID=123456

# Sepolia RPC (optional, for test deploys)
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# USDC token address on the target network.
# Must be a real, non-zero address - the deploy script rejects the zero address
# because every USDC-based contract reverts on it.
USDC_ADDRESS=

# Address that receives protocol fees. Defaults to the deployer if unset.
FEE_COLLECTOR=


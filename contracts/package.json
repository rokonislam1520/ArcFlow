{
  "name": "arcflow-contracts",
  "version": "1.0.0",
  "scripts": {
    "compile": "npx hardhat compile",
    "preflight": "node scripts/preflight.js",
    "deploy:arc": "npx hardhat run scripts/deploy.ts --network arcTestnet",
    "deploy:localhost": "npx hardhat run scripts/deploy.ts --network localhost",
    "deploy:pay:arc": "npx hardhat run scripts/deploy-pay.ts --network arcTestnet",
    "deploy:pay:dry": "npx hardhat run scripts/deploy-pay.ts",
    "test": "npx hardhat test"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "5.0.0",
    "@nomicfoundation/hardhat-ethers": "3.0.6",
    "hardhat": "2.22.10",
    "ethers": "6.13.2",
    "typescript": "5.5.4",
    "ts-node": "10.9.2",
    "dotenv": "16.4.5",
    "@types/node": "20.14.15"
  }
}

# Copy to `.env.local` and fill in after running `npm run deploy:*` in contracts/.
# The deploy script prints a ready-to-paste version of this block.

# Chain the frontend talks to (31337 = local hardhat node)
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_CHAIN_NAME=ARC Testnet
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# Optional block explorer base URL
NEXT_PUBLIC_EXPLORER_URL=

# Token + contract addresses
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_SEND_ADDRESS=
NEXT_PUBLIC_SWAP_ADDRESS=
NEXT_PUBLIC_PAY_ADDRESS=
NEXT_PUBLIC_RECURRING_ADDRESS=
NEXT_PUBLIC_SPLIT_ADDRESS=

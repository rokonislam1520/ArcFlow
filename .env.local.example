# Copy to `.env.local`.
#
# Send, Swap and Bridge need NO configuration: chains, RPC endpoints, token
# addresses and explorer URLs all come from Circle App Kit at runtime, so those
# features work as soon as you connect a wallet.
#
# The variables below only configure the custom ArcFlow contracts (Split,
# Merchant Pay, Recurring), which App Kit does not provide. Fill them in after
# running the deploy script in contracts/ — it prints a ready-to-paste block.

# ---------------------------------------------------------------------------
# Network selection
# ---------------------------------------------------------------------------

# "true" (default) shows testnets, including Arc Testnet.
# Set to "false" to show mainnets only. Do not mix: a route between a testnet
# and a mainnet cannot settle.
NEXT_PUBLIC_USE_TESTNET=true

# ---------------------------------------------------------------------------
# ArcFlow contract deployment
# ---------------------------------------------------------------------------
# Optional. When unset these default to the Arc chain from the App Kit
# registry. Set them only if your contracts live on a different network
# (for example a local hardhat node at chain 31337 / http://127.0.0.1:8545).
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_CHAIN_NAME=
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_EXPLORER_URL=

# Custom ArcFlow contract addresses. A feature stays hidden until its address
# is set, so an unconfigured page never renders a button that would revert.
NEXT_PUBLIC_SPLIT_ADDRESS=
NEXT_PUBLIC_PAY_ADDRESS=
NEXT_PUBLIC_RECURRING_ADDRESS=

# USDC address on the deployment chain, used by the contract flows above.
NEXT_PUBLIC_USDC_ADDRESS=

# ---------------------------------------------------------------------------
# Legacy contract addresses (optional)
# ---------------------------------------------------------------------------
# Send and Swap are now handled by App Kit, which routes through audited Circle
# infrastructure instead of these custom contracts. Leave blank unless you are
# intentionally running the older on-chain implementations.
NEXT_PUBLIC_SEND_ADDRESS=
NEXT_PUBLIC_SWAP_ADDRESS=

# Extra tokens for the legacy swap contract only. App Kit-powered pages read
# token addresses from the chain registry and ignore these.
NEXT_PUBLIC_EURC_ADDRESS=
NEXT_PUBLIC_EURC_DECIMALS=6
NEXT_PUBLIC_USDT_ADDRESS=
NEXT_PUBLIC_USDT_DECIMALS=6
NEXT_PUBLIC_DAI_ADDRESS=
NEXT_PUBLIC_DAI_DECIMALS=18
